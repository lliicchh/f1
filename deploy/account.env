# 账号服专用配置。
#
# 与 s1.env 一起加载（compose 里 account 的 env_file 是两份，后者覆盖前者）。
# 存在的理由和 gateway.env 一样：把这个进程不需要的密钥拿走。
# 账号服只签发登录票据，从不签发内部命令。

# 显式清空：即便 s1.env 里配了，这里也要覆盖成空。
INTERNAL_SECRET=
GM_SECRET=

# LOGIN_SECRET 是登录票据的密钥。账号服用它签发，网关用它校验，
# 两边必须一致，除这两个进程外谁都不该有。
LOGIN_SECRET=CHANGE-ME-login-32-bytes-min

# 票据有效期。到期后客户端要重新走一次渠道登录，
# 给短了渠道压力大，给长了被盗的票据能用更久。
TOKEN_TTL=30m

# ---- 渠道 ----
#
# 生产必须为 false。置 true 后任何字符串都会被当成合法 openid，
# 等于谁都能登进任何号。
IDP_SANDBOX=false

# 单次渠道校验的上限。这条路径尽头是第三方，掐不住就会把账号服的
# goroutine 全占住。网关侧的 authTimeout 要比它大。
IDP_TIMEOUT=3s

# 连续失败多少次熔断该渠道，以及熔断后隔多久放一个探针进去。
# 渠道挂了的时候，熔断把「所有人卡 3 秒」压回「这个渠道快速失败」。
IDP_BREAKER_FAILS=5
IDP_BREAKER_COOLDOWN=10s
