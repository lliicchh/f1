# 二区配置（§3.2）。
# 一区内所有进程（gateway / lobby / room ...）共用同一个 SERVER_ID 与 ETCD_PREFIX，
# 各自用不同的 NODE_SEQ（在 compose 的 environment 里给）。
# 开新区复制一份改号即可。

# ---- 身份 ----
SERVER_ID=2

# ---- 基础设施 ----
ETCD_ENDPOINTS=etcd:2379
ETCD_PREFIX=/game/s2
REDIS_ADDR=redis:6379
NATS_URL=nats://nats:4222

# ---- 运行 ----
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ADDR=:9100
LISTEN_ADDR=:7000

# ---- 分片（§4）----
# 常量，一经确定永不变更：变更等价于全量迁移。
SHARD_COUNT=1024
SHARD_LEASE_TTL=8s
SHARD_KEEPALIVE=2500ms
MAILBOX_SIZE=4096
MAILBOX_WARN_PCT=70

# ---- nodeID 自检（§3.4）----
# 与分片 lease 的取舍相反：回收慢只浪费一个槽位，回收快却会误判冲突拒绝启动。
NODE_STALE_TIMEOUT=10m
NODE_BEAT_INTERVAL=30s

# ---- 刷盘（§6.2）----
FLUSH_L1_INTERVAL=5s
FLUSH_L2_INTERVAL=60s
FLUSH_CHAN_SIZE=1024
FLUSH_WORKERS=8
FLUSH_BATCH_SIZE=128

# ---- 生命周期（§10）----
UNLOAD_IDLE=10m
SESSION_TTL=5m
# 必须小于 compose 的 stop_grace_period(60s)，否则刷盘会被 SIGKILL 打断。
SHUTDOWN_GRACE=55s

# ---- 跨分片（§8）----
TX_SCAN_INTERVAL=30s
TX_TIMEOUT=60s

# ---- 游戏配置与安全 ----
GAME_CONF=/etc/game/game.json
INTERNAL_SECRET=CHANGE-ME-s2-internal
PAYMENT_SECRET=CHANGE-ME-s2-payment
PAYMENT_SANDBOX=false
GM_SECRET=CHANGE-ME-s2-gm

# ---- Redis 安全阀（§6.4）----
# maxmemory-policy 不是 noeviction 时拒绝启动。除非你确认自己在做什么，否则别关。
REDIS_REQUIRE_NOEVICTION=true
# hash tag 取法：uid（默认，单实例/主从哨兵）| shard（Redis Cluster 必须用它，
# 否则 epoch 键与玩家键不同 slot，fencing 的 Lua 会 CROSSSLOT）
REDIS_HASHTAG=uid
