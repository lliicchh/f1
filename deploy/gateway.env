# 网关专用配置。
#
# 与 s1.env 一起加载（compose 里 gateway 的 env_file 是两份，后者覆盖前者）。
# 这份文件存在的唯一理由是**把内部密钥从网关手里拿走**（评审 P0-1）：
# 网关是唯一直接面向公网的进程，它不该有能力签发内部命令。

# 显式清空：即便 s1.env 里配了，这里也要覆盖成空。
INTERNAL_SECRET=
GM_SECRET=

# LOGIN_SECRET 是登录票据的验签密钥，只有网关需要（评审 P0-3）。
# 未配置且未显式开启 ALLOW_DEV_AUTH 时，所有登录都会被拒绝 —— 这是有意的默认拒绝。
LOGIN_SECRET=CHANGE-ME-login-32-bytes-min

# 仅本地开发可置 true：置 true 后任何 uid 都能直接登录。
ALLOW_DEV_AUTH=false
